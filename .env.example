# Copy to .env.local, then run neon deploy to populate the Neon-managed values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
MOVIS_IMAGE_BUCKET=assets
# Required only when bootstrapping an empty database. Choose private credentials.
MOVIS_ADMIN_USERNAME=
MOVIS_ADMIN_PASSWORD=
# Use demo only for synthetic scanning; yolo requires requirements-yolo.txt.
MOVIS_MODE=yolo
